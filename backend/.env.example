FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=sleepwise
MYSQL_USER=root
MYSQL_PASSWORD=

# Folder artefak ML (relatif terhadap backend/ bila tidak absolut)
MODEL_DIR=../ml/models
UPLOAD_DIR=uploads
DEFAULT_MODEL=selected

CORS_ORIGINS=*

# Batas upload dataset training
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_ROWS=200000
# Bila diisi, endpoint training wajib header X-Training-Token
TRAINING_TOKEN=
